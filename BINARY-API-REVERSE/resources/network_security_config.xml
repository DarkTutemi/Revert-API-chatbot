<?xml version="1.0" encoding="utf-8"?>
<!--
    Reqable & Reverse Engineering Permissive Network Security Config
    Place in: res/xml/network_security_config.xml
    Reference in AndroidManifest.xml:
      <application android:networkSecurityConfig="@xml/network_security_config" ...>
-->
<network-security-config>
    <!-- Allow cleartext HTTP traffic for local proxy testing -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <!-- Trust pre-installed system CAs -->
            <certificates src="system" />
            <!-- Trust user-installed CAs (Reqable, Charles, Burp Suite) on Android 7+ -->
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <!-- Fallback domain configuration for all subdomains -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </domain-config>
</network-security-config>
