{
  "manifest_version": 3,
  "name": "ChatGPT Proxy Bridge",
  "version": "1.2.3",
  "description": "Seamless bridge between local OpenAI API proxy and ChatGPT Web",
  "permissions": [
    "tabs",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["hook.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://chatgpt.com/*"
  ]
}
