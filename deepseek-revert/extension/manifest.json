{
  "manifest_version": 3,
  "name": "DeepSeek Web Proxy Bridge",
  "version": "1.3.0",
  "description": "High-speed bridge between local OpenAI API proxy and DeepSeek Web (chat.deepseek.com)",
  "permissions": [
    "tabs",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.deepseek.com/*",
        "https://*.deepseek.com/*",
        "https://deepseek.com/*"
      ],
      "js": ["hook.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chat.deepseek.com/*",
        "https://*.deepseek.com/*",
        "https://deepseek.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "host_permissions": [
    "http://localhost:3002/*",
    "https://*.deepseek.com/*",
    "https://deepseek.com/*",
    "<all_urls>"
  ]
}
