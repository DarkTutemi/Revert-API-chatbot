PORT=3000
API_KEY=long-random-string-guarding-your-gateway

# Lấy key: aistudio.google.com → "Get API key" (free)
GEMINI_API_KEY=

# Failover optional — điền cái nào có
GROQ_API_KEY=            # console.groq.com
OPENROUTER_API_KEY=      # openrouter.ai

# Hết quota provider 1 → tự rơi xuống 2, 3
PROVIDER_ORDER=gemini,groq,openrouter
DEFAULT_MODEL=gemini-2.5-flash
